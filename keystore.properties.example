# Copy to keystore.properties (gitignored) at the project root. Never commit real passwords.
#
# StoreSafe Play upload:
# 1. Create an upload key (or use Play App Signing with Google-generated key).
# 2. Point storeFile to your .jks path (relative to this repo root is fine, e.g. keystore/calling-release.jks).
# 3. Run: ./gradlew :mobile:bundleStoreSafeRelease
# 4. Upload: mobile/build/outputs/bundle/storeSafeRelease/mobile-storeSafe-release.aab
# 5. If you ship the Wear app separately, also: ./gradlew :wear:bundleStoreSafeRelease
#    (versionCode/versionName must match — see gradle.properties calling.version*)

storeFile=keystore/calling-release.jks
storePassword=CHANGE_ME
keyAlias=calling
keyPassword=CHANGE_ME
