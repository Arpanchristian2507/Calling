<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/callScreensRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_call_gradient"
    tools:context=".FakeIncomingCallActivity">

    <!-- Ringing / incoming only; active call uses @layout/activity_active_call (inflated in code). -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/incomingCallRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/incomingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_top_margin"
            android:letterSpacing="0.15"
            android:text="@string/fake_call_incoming_label"
            android:textAllCaps="true"
            android:textColor="@color/call_text_secondary"
            android:textSize="@dimen/call_text_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/callerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/call_name_horizontal_margin"
            android:layout_marginTop="@dimen/call_label_top_margin"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:textColor="@color/call_text_primary"
            android:textSize="@dimen/call_text_name"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/incomingLabel"
            tools:text="Priority line" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/call_number_top_margin"
            android:gravity="center"
            android:text="@string/fake_call_subtitle"
            android:textColor="@color/call_text_secondary"
            android:textSize="@dimen/call_text_number"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/callerName"
            tools:text="Mobile · Slide to focus" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/avatarCard"
            android:layout_width="@dimen/call_avatar_size"
            android:layout_height="@dimen/call_avatar_size"
            android:layout_marginTop="@dimen/call_avatar_top_margin"
            app:cardBackgroundColor="@color/call_avatar_bg"
            app:cardCornerRadius="@dimen/call_avatar_radius"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subtitle"
            app:strokeColor="@color/call_avatar_stroke"
            app:strokeWidth="@dimen/call_avatar_stroke">

            <ImageView
                android:id="@+id/callerAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/content_desc_caller_avatar"
                android:padding="@dimen/call_avatar_padding"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_person_outline"
                app:tint="@color/call_text_secondary" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/answer"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="@dimen/call_main_btn_size"
            android:layout_height="@dimen/call_main_btn_size"
            android:layout_marginBottom="@dimen/call_action_btn_bottom_margin"
            android:contentDescription="@string/fake_call_answer"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/call_answer_green"
            app:cornerRadius="@dimen/call_main_btn_radius"
            app:icon="@drawable/ic_call_answer"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/call_main_icon_size"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toTopOf="@id/homeBar"
            app:layout_constraintEnd_toStartOf="@id/decline"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginEnd="@dimen/call_btn_gap" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/decline"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="@dimen/call_main_btn_size"
            android:layout_height="@dimen/call_main_btn_size"
            android:layout_marginBottom="@dimen/call_action_btn_bottom_margin"
            android:contentDescription="@string/fake_call_decline"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/call_decline_red"
            app:cornerRadius="@dimen/call_main_btn_radius"
            app:icon="@drawable/ic_call_decline"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/call_main_icon_size"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toTopOf="@id/homeBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/answer" />

        <View
            android:id="@+id/homeBar"
            android:layout_width="@dimen/call_home_bar_width"
            android:layout_height="@dimen/call_home_bar_height"
            android:layout_marginBottom="@dimen/call_home_bar_bottom_margin"
            android:background="@color/call_home_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
